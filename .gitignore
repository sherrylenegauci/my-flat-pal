# Dependencies
node_modules/

# Build output
dist/
.vite/

# Build output produced by the build test tier (tests/build/), kept out of
# dist/ so running the suite cannot overwrite a real build. See the note in
# tests/build/typeface-precache.test.ts.
dist-test/

# Real-browser tier output: reports, traces, screenshots
playwright-report/
test-results/
blob-report/

# Environment / secrets — never commit an API key
.env
.env.*
!.env.example

# Agent tooling: keep committed skills, ignore local machine settings
.claude/settings.local.json

# OS
.DS_Store

# Agent worktrees — transient, never committed
.claude/worktrees/
